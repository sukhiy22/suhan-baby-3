{
  "botName": "SUHAN BOT",
  "version": "1.0.0",
  "author": "SUHAN AHMED",

  "prefix": "!",
  "language": "en",
  "timeZone": "Asia/Dhaka",

  "owner": {
    "name": "SUHAN AHMED",
    "uid": "61589732935126"
  },

  "adminBot": [
    "61589732935126"
  ],

  "settings": {
    "enableTypingIndicator": true,
    "typingDuration": 2000,
    "autoRead": true,
    "autoReact": false,
    "maintenance": false
  },

  "permissions": {
    "everyone": true,
    "adminOnlyCommands": [
      "ban",
      "unban",
      "kick",
      "prefix",
      "restart"

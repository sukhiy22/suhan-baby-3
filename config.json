  "whiteListMode": {
    "enable": false,
    "whiteListIds": []
  },

  "database": {
    "type": "sqlite",
    "autoSyncWhenStart": false
  },

  "autoRestart": {
    "enable": false,
    "time": null
  },

  "logging": {
    "enable": true,
    "message": true,
    "event": true,
    "reaction": true,
    "unsend": true
  },

  "botFeatures": {
    "ai": true,
    "music": true,
    "video": true,
    "tiktok": true,
    "facebookVideo": true
  }
